# Copy to .env and fill in. Never commit .env.

# PostgreSQL + pgvector (docker compose up -d starts one locally)
HALDEN_DSN=postgresql://halden:halden@localhost:5432/halden

# Optional: only needed for examples that call a live model.
# Every such example has an offline mode that needs no key.
ANTHROPIC_API_KEY=
HALDEN_MODEL=
HALDEN_MODEL_SMALL=
HALDEN_JUDGE_MODEL=          # evaluation judge (Chapter 23)

# Production settings (Chapters 24-27). Defaults shown.
# HALDEN_TELEMETRY=off       # off | console | otlp
# HALDEN_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# HALDEN_TELEMETRY_CAPTURE_CONTENT=false
# HALDEN_TELEMETRY_SALT=     # set a secret value in production
# HALDEN_ANSWER_CACHE_TTL_S= # e.g. 86400; unset = no answer cache
# HALDEN_DAILY_TOKEN_BUDGET= # per user; unset = no budget
# HALDEN_UNTRUSTED_SOURCES=["tickets"]
# HALDEN_ALLOWED_LINK_HOSTS=["halden.example"]
# HALDEN_INDEX_SCHEMA=public # blue/green re-index (Chapter 27)
